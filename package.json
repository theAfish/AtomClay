{
  "name": "atomclay",
  "private": false,
  "version": "0.1.0",
  "description": "Browser and Python toolkit for atomic structure modeling",
  "license": "MIT",
  "main": "./dist/atomclay.umd.cjs",
  "module": "./dist/atomclay.js",
  "exports": {
    ".": {
      "import": "./dist/atomclay.js",
      "require": "./dist/atomclay.umd.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": ["dist", "src", "atomclay", "pyproject.toml", "README.md", "LICENSE"],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "prepublishOnly": "npm run build:lib",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^25.6.3",
    "kekule": "^1.0.3",
    "lucide-react": "^0.303.0",
    "molstar": "^5.4.1",
    "mtz": "^0.1.0",
    "ngl": "^2.4.0",
    "pyodide": "^0.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.3.5",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@testing-library/react": "^13.4.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.32",
    "sass": "^1.94.2",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "vitest": "^4.0.14"
  }
}
